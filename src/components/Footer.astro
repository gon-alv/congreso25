---
import "../styles/global.css";
---

<footer class="footer mt-auto bg-[var(--primary-color)]">
  <div class="footer-container mx-auto max-w-6xl">
    <div class="grid grid-cols-1 mt-5 mx-10 xl:mx-0 lg:grid-cols-3 gap-8">
      <div class="footer-column">
        <ul class="contact-info space-y-2 text-md text-[var(--main-bg-color)]">
          <li class="flex items-start">
            <span class="text-xl font-bold">Universidad de Los Lagos</span>
          </li>
          <li class="flex items-start">
            <span class="text-gray-300 text-2xs"
              >Lord Cochrane 1046, Osorno</span
            >
          </li>
          <li class="flex items-start">
            <span>+56 9 642333000</span>
          </li>
          <li class="flex items-start text-white">
            <a
              href="https://www.facebook.com/profile.php?id=61579105246208"
              target="_blank"
              rel="noreferrer noopener"
            >
              <img
                src="/images/socials/white-facebook.svg"
                class="h-10 w-10 mr-2"
              />
            </a>
            <a
              href="https://www.instagram.com/encuentro_secretarias_2025"
              target="_blank"
              rel="noreferrer noopener"
            >
              <img
                src="/images/socials/white-instagram.svg"
                class="h-10 w-10"
              />
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-column">
        <ul class="space-y-2 text-md text-[var(--main-bg-color)] mt-5">
          <li>
            <a
              href="https://sence.gob.cl/"
              target="_blank"
              rel="noreferrer noopener"
              class="hover:text-[var(--primary-hover-color)] transition-colors"
            >
              <img src="/images/marca/sence-blanco.png" width="250px" />
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-column">
        <div class="space-y-4 flex flex-col lg:items-end">
          <div>
            <a
              href="https://www.ulagos.cl/"
              target="_blank"
              rel="noreferrer noopener"
              class="block hover:opacity-80 transition-opacity"
            >
              <img
                src="/images/marca/ULAGOS-02.png"
                alt="Universidad de Los Lagos"
                width="200"
                class="max-w-full h-auto"
              />
            </a>
          </div>
          <div>
            <img
              src="/images/marca/acredt.png"
              alt="Acreditación"
              width="200"
              class="max-w-full h-auto"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-[var(--primary-hover-color)] mt-8 pt-4">
      <p class="text-center text-[var(--primary-hover-color)] text-4xs">
        © 2025 <a href="https://github.com/gon-alv">gon-alv</a>. Todos los
        derechos reservados.
      </p>
    </div>
  </div>
</footer>
