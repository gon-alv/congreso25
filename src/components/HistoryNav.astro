---
const currentPath = Astro.url.pathname;
---

<nav class="flex bg-white shadow pt-2.5 relative">
  <div
    class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center w-full"
  >
    <!-- Logo/Brand - Siempre visible -->
    <div class="flex items-center">
      <span class="text-lg font-bold text-[var(--primary-color)] md:hidden"
        >ULagos</span
      >
    </div>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex space-x-0 text-sm font-medium">
      <a
        href="/historia"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath === "/historia" || currentPath === "/historia/"
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        ULagos
      </a>
      <a
        href="/historia/campus-osorno"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/campus-osorno")
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        Campus Osorno
      </a>
      <a
        href="/historia/campus-chinquihue"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/campus-chinquihue")
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        Sede Puerto Montt
      </a>
      <a
        href="/historia/sede-chiloe"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/sede-chiloe")
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        Sede Chiloé
      </a>
      <a
        href="/historia/sede-santiago"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/sede-santiago")
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        Sede Santiago
      </a>
      <a
        href="/historia/congresos"
        class:list={[
          "text-md px-2 font-bold hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/congresos")
            ? "text-[var(--primary-color)]"
            : "text-gray-700",
        ]}
      >
        Congresos de Secretarias
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1 focus:outline-none focus:ring-2 focus:ring-[var(--primary-color)] rounded"
      aria-label="Abrir menú de navegación"
    >
      <span
        class="block w-6 h-0.5 bg-gray-700 transition-transform duration-300"
        id="hamburger-line-1"></span>
      <span
        class="block w-6 h-0.5 bg-gray-700 transition-opacity duration-300"
        id="hamburger-line-2"></span>
      <span
        class="block w-6 h-0.5 bg-gray-700 transition-transform duration-300"
        id="hamburger-line-3"></span>
    </button>
  </div>

  <!-- Mobile Navigation Menu (Initially Hidden) -->
  <div
    id="mobile-menu"
    class="absolute top-full left-0 w-full bg-white shadow-lg border-t md:hidden transform -translate-y-2 opacity-0 invisible transition-all duration-300 ease-in-out z-50"
  >
    <div class="px-4 py-3 space-y-1">
      <a
        href="/historia"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath === "/historia" || currentPath === "/historia/"
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        ULagos
      </a>
      <a
        href="/historia/campus-osorno"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/campus-osorno")
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        Campus Osorno
      </a>
      <a
        href="/historia/campus-chinquihue"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/campus-chinquihue")
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        Sede Puerto Montt
      </a>
      <a
        href="/historia/sede-chiloe"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/sede-chiloe")
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        Sede Chiloé
      </a>
      <a
        href="/historia/sede-santiago"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/sede-santiago")
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        Sede Santiago
      </a>
      <a
        href="/historia/congresos"
        class:list={[
          "block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-100 hover:text-[var(--primary-hover-color)] transition-colors",
          currentPath.startsWith("/historia/congresos")
            ? "text-[var(--primary-color)] bg-gray-50"
            : "text-gray-700",
        ]}
      >
        Congresos de Secretarias
      </a>
    </div>
  </div>
</nav>

<div id="nav-spacer" class="h-0"></div>

<style>
  /* Desktop Navigation Styles */
  nav a {
    font-size: 1.25rem;
  }

  /* Mobile Menu States */
  .mobile-menu-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Hamburger Animation States */
  .hamburger-open #hamburger-line-1 {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger-open #hamburger-line-2 {
    opacity: 0;
  }

  .hamburger-open #hamburger-line-3 {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* Media Queries for Fine-tuning */
  @media (max-width: 640px) {
    nav a {
      font-size: 1.1rem;
    }

    .max-w-6xl {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    nav {
      padding-top: 0.5rem;
    }

    nav a {
      font-size: 1rem;
    }

    .max-w-6xl {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* Tablet Adjustments */
  @media (min-width: 641px) and (max-width: 768px) {
    nav a {
      font-size: 1.15rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  /* Large Desktop Optimizations */
  @media (min-width: 1024px) {
    nav a {
      font-size: 1.25rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* Accessibility: Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #hamburger-line-1,
    #hamburger-line-2,
    #hamburger-line-3,
    nav a {
      transition: none;
    }
  }

  /* Focus States for Better Accessibility */
  @media (max-width: 767px) {
    #mobile-menu a:focus {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }
  }
</style>

<script type="module" src="scripts/history-menu.js"></script>
