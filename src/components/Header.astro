---
import "../styles/global.css";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Historia", href: "/historia" },
  { label: "Organización", href: "/equipo" },
  { label: "Programa", href: "/programa" },
  { label: "Alojamiento", href: "/hoteles" },
  { label: "Inscripciones", href: "/inscripciones" },
  { label: "Contacto", href: "/contacto" },
];
---

<header
  class="fixed h-25 items-center xl:align-middle top-0 left-0 w-full bg-[var(--primary-color)] z-[999] shadow-xl"
>
  <div class="mx-5 flex justify-between xl:px-5">
    <div class="flex-shrink-0">
      <a href="/" class="flex pt-5 items-center space-x-0">
        <img
          src="/images/marca/logo-header.png"
          alt="Logo"
          class="h-17 w-auto"
        />
      </a>
    </div>

    <div class="flex items-center space-x-6 align-middle">
      <nav class="h-full align-middle hidden xl:flex font-bold text-white">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="hover:bg-linear-to-t from-[var(--primary-color)] to-[var(--primary-hover-color)] pt-10 px-3 duration-7000"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <button
        id="menu-toggle"
        class="xl:hidden p-2 rounded focus:outline-none focus:ring-2 focus:ring-[var(--active-color)]"
        aria-label="Abrir menú"
      >
        <svg
          class="w-12 h-12"
          fill="none"
          stroke="white"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden px-15 mt-3 pb-4 bg-[#e1d0ee] border-t border-gray-200 transition-all duration-300 ease-in-out"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block text-2xl font-bold py-2 text-gray-600 hover:text-[var(--primary-color)]"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>
<!--
<script type="module" src="../scripts/menu.js"></script>
-->
<script>
  function setupMenu() {
    const toggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    if (toggle && mobileMenu) {
      toggle.onclick = () => {
        mobileMenu.classList.toggle("hidden");
      };
      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.onclick = () => {
          mobileMenu.classList.add("hidden");
        };
      });
    }
  }

  // Ejecutar en carga inicial
  setupMenu();

  // Re-ejecutar después de cada navegación de Astro
  document.addEventListener("astro:page-load", setupMenu);
</script>

<style>
  nav a {
    font-size: 1.1rem;
  }
</style>
