---
import "../styles/global.css";

const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Historia", href: "/historia" },
  { label: "Organización", href: "/equipo" },
  { label: "Programa", href: "/programa" },
  { label: "Alojamiento", href: "/hoteles" },
  { label: "Inscripciones", href: "/inscripciones" },
  { label: "Contacto", href: "/contacto" },
];
---

<header
  class="fixed h-25 items-center xl:align-middle top-0 left-0 w-full bg-[var(--primary-color)] z-[999] shadow-xl"
>
  <div class="mx-5 flex justify-between xl:px-5">
    <div class="flex-shrink-0">
      <a href="/" class="flex pt-5 items-center space-x-0">
        <img
          src="/images/marca/logo-header.png"
          alt="Logo"
          class="h-17 w-auto"
        />
      </a>
    </div>

    <div class="flex items-center space-x-6 align-middle">
      <nav class="h-full align-middle hidden xl:flex font-bold text-white">
        {
          navItems.map((item) => (
            <a
              aref={item.href}
              alass="hover:bg-linear-to-t from-[var(--primary-color)] to-[var(--primary-hover-color)] pt-10 px-3 duration-700"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <button
        id="menu-toggle"
        class="xl:hidden p-2 rounded focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg
          id="hamburger-icon"
          class="w-12 h-12 block"
          fill="none"
          stroke="white"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path id="line1" d="M4 6h16"></path>
          <path id="line2" d="M4 12h16"></path>
          <path id="line3" d="M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="w-12 h-12 hidden"
          fill="none"
          stroke="white"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden px-15 mt-3 pb-4 bg-[#e1d0ee] border-t border-gray-200 mobile-menu-anim"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block text-2xl font-bold py-2 text-gray-600 hover:text-[var(--primary-color)]"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>
<!--
<script type="module" src="../scripts/menu.js"></script>
-->
<script>
  function setupMenu() {
    const toggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    if (toggle && mobileMenu && hamburgerIcon && closeIcon) {
      toggle.onclick = () => {
        mobileMenu.classList.toggle("hidden");
        hamburgerIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
      };
      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.onclick = () => {
          mobileMenu.classList.add("hidden");
          hamburgerIcon.classList.remove("hidden");
          closeIcon.classList.add("hidden");
        };
      });
    }
  }

  // Ejecutar en carga inicial
  setupMenu();

  // Re-ejecutar después de cada navegación de Astro
  document.addEventListener("astro:page-load", setupMenu);
</script>

<style>
  nav a {
    font-size: 1.1rem;
  }
  @keyframes menuOpen {
    from {
      max-height: 0;
      opacity: 0;
    }
    to {
      max-height: 500px;
      opacity: 1;
    }
  }
  @keyframes menuClose {
    from {
      max-height: 500px;
      opacity: 1;
    }
    to {
      max-height: 0;
      opacity: 0;
    }
  }
  /* New keyframes for navmenu closing animation */
  @keyframes navMenuFadeOut {
    0% {
      opacity: 1;
      max-height: 500px;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      max-height: 0;
      transform: translateY(-20px);
    }
  }
  .mobile-menu-anim {
    transition: none;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    animation: navMenuFadeOut 0.5s forwards;
  }
  .mobile-menu-anim:not(.hidden) {
    max-height: 500px;
    opacity: 1;
    animation: menuOpen 0.5s forwards;
  }

  @keyframes iconShowClockwise {
    from {
      opacity: 0;
      transform: scale(0.8) rotate(-90deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(180deg);
    }
  }
  @keyframes iconHideCounterClockwise {
    from {
      opacity: 1;
      transform: scale(1) rotate(180deg);
    }
    to {
      opacity: 0;
      transform: scale(0.8) rotate(-90deg);
    }
  }
  @keyframes iconShowCounterClockwise {
    from {
      opacity: 0;
      transform: scale(0.8) rotate(90deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  @keyframes iconHideClockwise {
    from {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
    to {
      opacity: 0;
      transform: scale(0.8) rotate(90deg);
    }
  }
  #hamburger-icon {
    transition: none;
    opacity: 1;
    transform: scale(1) rotate(0deg);
    animation: iconShowCounterClockwise 0.5s forwards;
  }
  #hamburger-icon.hidden {
    opacity: 0;
    transform: scale(0.8) rotate(90deg);
    pointer-events: none;
    animation: iconHideClockwise 0.5s forwards;
  }
  #close-icon {
    transition: none;
    opacity: 1;
    transform: scale(1) rotate(180deg);
    animation: iconShowClockwise 0.5s forwards;
  }
  #close-icon.hidden {
    opacity: 0;
    transform: scale(0.8) rotate(-90deg);
    pointer-events: none;
    animation: iconHideCounterClockwise 0.5s forwards;
  }
</style>
