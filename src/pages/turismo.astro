---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const hoteles = await getCollection("hoteles");
---

<Layout title="XIX Encuentro Nacional de Secretarias del CRUCh">
  <div class="h-25"></div>
  <div class="h-25">
    <h1>Encuentre su alojamiento en Castro</h1>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      hoteles.map(({ data }) => (
        <div class="bg-white shadow-lg rounded-lg p-4">
          <img
            src={data.imagen}
            alt={data.nombre}
            class="w-full h-48 object-cover rounded"
          />
          <h2 class="text-xl font-semibold mt-2">{data.nombre}</h2>
          <p>{data.direccion}</p>
          <p>
            <a href={`tel:${data.telefono}`}>{data.telefono}</a>
          </p>
          <p>
            <a href={`mailto:${data.email}`}>{data.email}</a>
          </p>
          {data.web && (
            <p>
              <a href={data.web} target="_blank" rel="noopener">
                Sitio Web
              </a>
            </p>
          )}
          <div class="flex gap-2 mt-2">
            {data.redes?.facebook && (
              <a href={data.redes.facebook} target="_blank">
                FB
              </a>
            )}
            {data.redes?.instagram && (
              <a href={data.redes.instagram} target="_blank">
                IG
              </a>
            )}
            {data.redes?.twitter && (
              <a href={data.redes.twitter} target="_blank">
                X
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Layout>

<style></style>
